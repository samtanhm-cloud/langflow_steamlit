# Streamlit Secrets Template
# 
# Instructions:
# 1. Copy this file to: .streamlit/secrets.toml
# 2. Fill in your actual values below
# 3. ⚠️ NEVER commit the actual secrets.toml file to git!

# ========================================
# Langflow Configuration
# ========================================

# Your Langflow API endpoint URL
# Current flow ID: 3cc7c38d-7371-49b0-a741-f20e9e902c8b
LANGFLOW_API_ENDPOINT = "http://localhost:7860/api/v1/run/3cc7c38d-7371-49b0-a741-f20e9e902c8b"

# Your Langflow API key (if your Langflow instance requires authentication)
LANGFLOW_API_KEY = "your-langflow-api-key-here"

# ========================================
# Gemini API Configuration
# ========================================

# Your Google Gemini API key (required for the Gemini model in Langflow)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY = "your-gemini-api-key-here"

# Alternative environment variable names (Gemini SDK supports both)
GOOGLE_API_KEY = "your-gemini-api-key-here"

# ========================================
# Notes
# ========================================

# For remote deployment:
# LANGFLOW_API_ENDPOINT = "https://your-langflow-server.com/api/v1/run/YOUR_FLOW_ID"

# For local Ollama (if you switch back from Gemini):
# OLLAMA_BASE_URL = "http://localhost:11434/"
